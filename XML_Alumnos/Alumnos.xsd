<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
        <xs:simpleType name="dni">
            <xs:restriction base="xs:string">
                <xs:pattern value="[0-9]{8}[A-Z]"/>
            </xs:restriction>
        </xs:simpleType>
        <xs:simpleType name="codigoPostal">
            <xs:restriction base="xs:string">
                <xs:pattern value="[0-9]{5}"/>
            </xs:restriction>
        </xs:simpleType>
    <xs:element name="alumnos">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="alumno" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="nombre" type="xs:string"/>
                            <xs:element name="apellidos" type="xs:string"/>
                            <xs:element name="numeroTelefono" type="xs:integer"/>
                            <xs:element name="correoElectronico" type="xs:string"/>
                        </xs:sequence>
                        <xs:attribute name="dni" type="dni" use="required"/>
                        <xs:attribute name="fechaNacimiento" type="xs:date"/>
                        <xs:attribute name="domicilio" type="xs:string"/>
                        <xs:attribute name="codigoPostal" type="codigoPostal"/>
                        <xs:attribute name="idiomaNativo" type="xs:string"/>
                        <xs:attribute name="dniProfesor" type="dni" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>